{
  "realm": "lakehouse",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Writer",
      "email": "alice@example.org",
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "NoAccess",
      "email": "bob@example.org",
      "credentials": [
        { "type": "password", "value": "bob", "temporary": false }
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "ProjW",
      "email": "carol@example.org",
      "credentials": [
        { "type": "password", "value": "carol", "temporary": false }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "trino",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "trino-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "fullScopeAllowed": true,
      "attributes": { "standard.token.exchange.enabled": "true" },
      "protocolMappers": [
        {
          "name": "principal_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "principal_name",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "polaris",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false
    }
  ]
}
