{
  "realm": "lakehouse",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [
    { "name": "jgi-writers", "path": "/jgi-writers" },
    { "name": "projw-team", "path": "/projw-team" },
    { "name": "no-access", "path": "/no-access" },
    { "name": "stewards", "path": "/stewards" }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Writer",
      "email": "alice@example.org",
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ],
      "groups": ["/jgi-writers", "/stewards"]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "NoAccess",
      "email": "bob@example.org",
      "credentials": [
        { "type": "password", "value": "bob", "temporary": false }
      ],
      "groups": ["/no-access"]
    },
    {
      "username": "carol",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "ProjW",
      "email": "carol@example.org",
      "credentials": [
        { "type": "password", "value": "carol", "temporary": false }
      ],
      "groups": ["/projw-team", "/stewards"]
    },
    {
      "username": "service-account-idp-shim",
      "enabled": true,
      "serviceAccountClientId": "idp-shim",
      "clientRoles": { "realm-management": ["view-users"] }
    }
  ],
  "clients": [
    {
      "clientId": "trino",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "trino-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "principal_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "principal_name",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "principal_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "principal_roles",
            "full.path": "false",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "polaris-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "polaris",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "polaris",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "idp-shim",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "shim-kc-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ]
}
