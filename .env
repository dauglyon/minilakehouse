# minilakehouse — pinned images + identifiers.
# All values are referenced from docker-compose.yml and the bootstrap scripts. Everything
# here is a throwaway DEV credential (the system runs plaintext on a trusted network).

# ---- Images (pinned concrete tags; verified available 2026-06) ----
POSTGRES_IMAGE=postgres:16
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.6.1
OPA_IMAGE=openpolicyagent/opa:1.17.1-debug
POLARIS_IMAGE=apache/polaris:1.5.0
POLARIS_ADMIN_IMAGE=apache/polaris-admin-tool:1.5.0
TRINO_IMAGE=trinodb/trino:484
CEPH_IMAGE=ghcr.io/kbasetest/ceph-rgw-test-image:0.1.5
CURL_IMAGE=alpine/curl:8.17.0
MC_IMAGE=minio/mc@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727

# ---- Postgres ----
POSTGRES_DB=polaris
POSTGRES_USER=polaris
POSTGRES_PASSWORD=polaris

# ---- Polaris ----
# Internal bootstrap realm + root admin credential (Polaris-internal OAuth).
POLARIS_REALM=POLARIS
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=s3cr3t
# Polaris principal governance logs in as to create each person's principal on first use;
# OPA lets it create principals and nothing else.
PROVISIONER_CLIENT_ID=provisioner-client
PROVISIONER_CLIENT_SECRET=provisioner-secret
# Catalog / Iceberg warehouse name.
CATALOG_NAME=lakehouse
# STS role Polaris assumes (against RGW) to mint per-table scoped credentials.
STS_ROLE_ARN=arn:aws:iam:::role/polaris-vendor
# Shared secret RGW adds to every bucket notification (the topic's opaque data); governance
# refuses events without it.
EVENTS_SECRET=dev-events-secret

# ---- Ceph RGW (S3) ----
# The RGW admin key, held only by Ceph itself and the one-shot setup jobs (bucket creation,
# bucket policy and notifications). No long-lived service holds it.
RGW_ACCESS_KEY=test_access_key
RGW_SECRET_KEY=test_access_secret
S3_BUCKET=lakehouse
# Dedicated RGW user Polaris authenticates as: no S3 rights of its own, only the ability to
# assume the polaris-vendor role. Created by ceph/sts-bootstrap.sh.
POLARIS_S3_KEY=polaris-catalog
POLARIS_S3_SECRET=polaris-catalog-secret
S3_REGION=us-east-1
# Server-side key RGW uses to sign STS session tokens (must be 16 alphanumeric chars).
RGW_STS_KEY=abcdef0123456789

# ---- Keycloak ----
KC_REALM=lakehouse
KC_ADMIN=admin
KC_ADMIN_PASSWORD=admin
# Confidential client users log in through, and whose service account
# (service-account-trino, granted nothing) Trino uses for its own catalog calls.
TRINO_CLIENT_ID=trino
TRINO_CLIENT_SECRET=trino-secret
# Audience Trino's authenticator and Polaris require on a user's token.
POLARIS_CLIENT_ID=polaris
# Trino requires a cluster-internal secret once an authenticator is configured.
TRINO_INTERNAL_SECRET=trino-internal-dev-secret
# Password of the self-signed keystore the Trino container generates for HTTPS (port 8443).
TRINO_TLS_PASSWORD=trino-tls-dev

# ---- Blob broker (Flow C) ----
# Dedicated RGW user the broker authenticates as (holds no S3 rights of its own — only
# the ability to assume the blob-vendor role). Created by ceph/sts-bootstrap.sh.
BLOB_BROKER_KEY=blob-broker
BLOB_BROKER_SECRET=blob-broker-secret
BLOB_ROLE_ARN=arn:aws:iam:::role/blob-vendor
BLOB_WRITE_ROLE_ARN=arn:aws:iam:::role/blob-writer
BLOB_DELETE_ROLE_ARN=arn:aws:iam:::role/blob-deleter
BLOB_MOVE_ROLE_ARN=arn:aws:iam:::role/blob-mover

# Least-privilege RGW user the governance service lists with (ListBucket on datasets/*,
# granted by the rgw-setup one-shot). Keeps the RGW admin key out of the long-lived service.
GOVERNANCE_READER_KEY=governance-reader
GOVERNANCE_READER_SECRET=governance-reader-secret
